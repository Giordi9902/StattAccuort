# Copy to .env for `docker compose`.
# Where browsers reach the app: baked into the frontend build, so rebuild (`--build`) after a change.
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
POSTGRES_PASSWORD=change-me
# Anonymous device fingerprint key for report rate limiting: `openssl rand -hex 32`.
REPORT_HASH_SECRET=
REPORT_COOLDOWN_SECONDS=600
LOG_LEVEL=info
# Admin dashboard (/admin in the app): at least 32 characters, `openssl rand -hex 32`. Empty disables it.
ADMIN_TOKEN=
# Horizontal scaling: API replicas behind Caddy, each with its own database pool.
API_REPLICAS=1
DATABASE_POOL_MAX=10
