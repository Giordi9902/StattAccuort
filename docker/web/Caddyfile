{
	admin off
}

:80 {
	encode zstd gzip

	# API: /api/v0/... → the api replicas. Caddy sets X-Forwarded-For (the API runs with TRUST_PROXY).
	handle_path /api/* {
		# Operational endpoints stay on the internal network: Prometheus scrapes the replicas directly.
		@internal path /metrics /healthz /readyz
		respond @internal 404

		reverse_proxy {
			# Docker DNS answers `api` with one address per running replica, so
			# `docker compose up --scale api=N` needs no change here. Re-resolved every few seconds.
			dynamic a api 8787 {
				refresh 5s
			}
			lb_policy least_conn
			# Caddy runs no active health checks on dynamic upstreams. A replica that stops accepting
			# connections (shutting down, crashed) is skipped for fail_duration, and a request that could
			# not reach it is retried on another one: a failed connection is always safe to retry.
			fail_duration 10s
			max_fails 1
			lb_try_duration 5s
			lb_try_interval 250ms
		}
	}

	# Basemap: styles rewritten by start.sh, archives straight from the tile build (range requests).
	# CORS on the styles too: the bundle points at PUBLIC_URL, so opening the app from any other
	# address (localhost instead of the LAN IP) makes the style a cross-origin request.
	handle_path /tiles/styles/* {
		root * /srv/tile-styles
		header Cache-Control "no-cache"
		header Access-Control-Allow-Origin "*"
		file_server
	}
	handle_path /tiles/* {
		root * /tiles
		header Access-Control-Allow-Origin "*"
		file_server
	}

	# The single-page app: unknown paths fall back to index.html for the client router.
	handle {
		root * /srv/app
		# Only files that exist get the year-long cache: a 404 must never be kept as an asset.
		@immutable {
			path /assets/*
			file
		}
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header /sw.js Cache-Control "no-cache"
		# Only routes fall back to the shell. A missing /assets/ file must stay a 404: answered with
		# index.html instead, a tab from before a rebuild gets HTML for its lazy map chunk and the
		# import fails without the app being able to tell why.
		@route {
			not path /assets/*
			not file
		}
		rewrite @route /index.html
		file_server
	}

}
