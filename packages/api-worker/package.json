{
  "name": "api-worker",
  "private": true,
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d --wait",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate-cli.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx --env-file-if-exists=.env src/db/seed/seed-db.ts",
    "db:seed:refresh": "bun run src/db/seed/seed-refresh.ts",
    "timetables:import": "tsx --env-file-if-exists=.env src/db/timetables/import.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@types/lodash": "^4.17.20",
    "@types/luxon": "^3.7.1",
    "drizzle-orm": "^0.44.7",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.10.7",
    "lodash": "^4.17.21",
    "luxon": "^3.7.2",
    "postgres": "^3.4.9",
    "prom-client": "15.1.3",
    "typescript": "^5.9.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@hono/zod-validator": "^0.7.4",
    "@types/bun": "1.3.1",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.46.3",
    "@typescript-eslint/parser": "^8.46.3",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.1",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "jiti": "^2.4.2",
    "prettier": "^3.6.2",
    "tsx": "^4.22.4",
    "typescript-eslint": "^8.46.3",
    "vitest": "~3.2.0"
  },
  "trustedDependencies": [
    "esbuild",
    "sharp",
    "unrs-resolver"
  ]
}
