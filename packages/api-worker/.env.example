# Copy to .env. Read by `bun run dev`, the seed and the timetable import.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/stattaccuort
PORT=8787
# Listen on every interface so phones on the LAN can reach the dev API; use 127.0.0.1 to keep it local.
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:1871,http://127.0.0.1:1871,capacitor://localhost
# Keys the anonymous device fingerprint of report submissions. Any long random string; changing it
# resets every rate limit and "own report" match.
REPORT_HASH_SECRET=change-me
# Minimum seconds between two reports from the same device.
REPORT_COOLDOWN_SECONDS=600
# Behind a reverse proxy, read the client IP from X-Forwarded-For.
TRUST_PROXY=false
# How long stations, lines and segments stay cached in memory after a read.
REFERENCE_CACHE_TTL_SECONDS=600
# Bearer token of the admin API (/v0/admin), at least 32 characters. Empty disables it (503).
ADMIN_TOKEN=
# Connections per process. With several replicas, replicas × this must stay below max_connections.
DATABASE_POOL_MAX=10
# On SIGTERM, seconds to keep serving while /readyz fails, so a load balancer that polls it can
# move traffic away first. 0 closes the listener straight away (enough behind Caddy).
SHUTDOWN_DRAIN_SECONDS=0
