VITE_API_URL=https://api.stattaccuort.it

# PostHog project API key (public — shipped in the client bundle). EU Cloud.
VITE_POSTHOG_KEY=
# Reverse proxy (worker/index.ts) so ad blockers can't drop events by blocking *.posthog.com.
VITE_POSTHOG_HOST=https://app.stattaccuort.it/relay
VITE_POSTHOG_FEEDBACK_SURVEY_ID=

# Cloudflare Turnstile site key (public — shipped in the client bundle). Empty disables the challenge;
# the matching secret lives as a Worker secret on api-worker, which skips verification until it is set.
VITE_TURNSTILE_SITE_KEY=

# Sentry DSN for error monitoring (public — shipped in the client bundle). EU region (ingest.de.sentry.io).
VITE_SENTRY_DSN=

# Social links shown in the app (settings + map).
VITE_GITHUB_URL=https://github.com/Giordi9902/StattAccuort
VITE_INSTAGRAM_URL=
